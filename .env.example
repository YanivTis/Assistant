# AI Provider — "anthropic" or "openai"
AI_PROVIDER=openai                                  # Which AI backend to use

# Claude / Anthropic (required if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-20250514               # Optional, defaults to Sonnet

# OpenAI (required if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o                                 # Optional, defaults to gpt-4o

# WhatsApp Business Cloud API
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token      # You choose this, used during webhook setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token     # From Meta Developer Portal
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id        # From Meta Developer Portal
WHATSAPP_ALLOWED_NUMBERS=1234567890,0987654321       # Comma-separated phone numbers (with country code, no +)

# Database
DB_PATH=./assistant.db                               # Optional, defaults to ./assistant.db

# Server
HOST=0.0.0.0                                        # Optional
PORT=8080                                            # Optional

# Misc
LOG_LEVEL=INFO                                       # Optional
MAX_HISTORY=30                                       # Optional, conversation context window
